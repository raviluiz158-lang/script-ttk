--  FOV + DEBUG
-- ============================================================
local fovCircle, debugText
if HAS_DRAWING then
    fovCircle = Drawing.new("Circle")
    fovCircle.Thickness, fovCircle.NumSides, fovCircle.Filled = 1, 64, false
    fovCircle.Color, fovCircle.Transparency = Color3.fromRGB(255, 255, 255), 0.6

    debugText = Drawing.new("Text")
    debugText.Size, debugText.Outline = 16, true
    debugText.Color = Color3.fromRGB(0, 255, 100)
    debugText.Position = Vector2.new(20, 60)
    debugText.Visible = false

    RunService.RenderStepped:Connect(function()
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        fovCircle.Radius   = Config.FOV
        fovCircle.Visible  = Config.UseFOV and Config.AimbotEnabled and not Config.SilentOnly

        debugText.Visible = Config.Debug and Config.AimbotEnabled
        if debugText.Visible then
            if currentTarget then
                debugText.Text  = "🎯 " .. currentTarget.Name
                debugText.Color = Color3.fromRGB(0, 255, 100)
            else
                debugText.Text  = "❌ Sem alvo"
                debugText.Color = Color3.fromRGB(255, 60, 60)
            end
        end
    end)
end

